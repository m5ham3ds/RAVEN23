# Tracked build configuration template. GitHub Actions copies this file to .env.
# Put the TMDB v3 API KEY below if you want it preserved when recreating the repository.
# Only use public client keys here: never put TMDB Read Access Tokens or private secrets in this file.
# Values in this file are packaged into the APK and can be extracted by users.
TMDB_API_KEY=7fe9c75d9f8106f12b42bc50fa7f6671
MIXPANEL_API_KEY=
# Optional application key for the current OpenSubtitles REST API. A client key
# is extractable from the APK; use the legacy public search only as fallback.
OPENSUBTITLES_API_KEY=
# Optional SubDL API key. This is also packaged into the APK when supplied.
SUBDL_API_KEY=
# Optional URL for your own ArabicSubs proxy. Keep the ArabicSubs Bearer key
# on your server; never put ARABICSUBS_API_KEY in this client environment.
ARABICSUBS_PROXY_URL=
CONSUMET_URL=
# Existing scraper host is retained for compatibility until a new RAVEN23 API host is provisioned.
RAVEN23_API_URL=https://scraper-1.flixquest.app
FLIXHQ_NEW_URL=
FLIXAPI_URL=
UNITY_GAME_ID_ANDROID=
UNITY_BANNER_PLACEMENT_ID=
UNITY_INTERSTITIAL_PLACEMENT_ID=
UNITY_REWARDED_PLACEMENT_ID=
UNITY_TEST_MODE=false

# Use a URL reachable by the target device, including its port when needed.
# /api/v1 is appended automatically if omitted. Build defines take precedence.
# Initial Laravel backend URL. Firebase Remote Config may override it only in
# a future Firebase-enabled build (users, billing, wallet, sync and other APIs).
LARAVEL_API_URL=http://10.0.2.2:8000

# Public OneSignal App ID (never the REST API key). Empty keeps the plain FCM
# client. A --dart-define=ONESIGNAL_APP_ID build define takes precedence.
ONESIGNAL_APP_ID=
